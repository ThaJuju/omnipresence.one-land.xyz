{
  "name": "blackmdt",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:bot": "turbo dev --filter=bot",
    "build": "turbo build",
    "build:web": "turbo build --filter=web",
    "build:bot": "turbo build --filter=bot",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo db:generate --filter=@repo/db",
    "db:migrate": "turbo db:migrate --filter=@repo/db",
    "db:migrate:prod": "turbo db:migrate:prod --filter=@repo/db",
    "db:migrate:status": "turbo db:migrate:status --filter=@repo/db",
    "db:studio": "turbo db:studio --filter=@repo/db",
    "db:seed": "turbo db:seed --filter=@repo/db",
    "db:reset": "turbo db:reset --filter=@repo/db"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
