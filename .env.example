# ════════════════════════════════════════════════════
# BASE DE DONNÉES
# ════════════════════════════════════════════════════
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/discordpanel"

# ════════════════════════════════════════════════════
# DISCORD APPLICATION
# (Discord Developer Portal → Applications → OAuth2)
# ════════════════════════════════════════════════════
DISCORD_CLIENT_ID="your-discord-app-client-id"
DISCORD_CLIENT_SECRET="your-discord-app-client-secret"
DISCORD_BOT_TOKEN="your-bot-token"

# ════════════════════════════════════════════════════
# WEB (Next.js)
# ════════════════════════════════════════════════════
NEXTAUTH_URL="https://votre-domaine.com"
NEXTAUTH_SECRET="générer avec : openssl rand -base64 32"

WEB_PORT=3000

# ════════════════════════════════════════════════════
# BOT (serveur HTTP interne)
# ════════════════════════════════════════════════════
BOT_HTTP_PORT=3001

# ════════════════════════════════════════════════════
# SECRET PARTAGÉ bot ↔ web
# (générer avec : openssl rand -hex 32)
# ════════════════════════════════════════════════════
BOT_INTERNAL_SECRET="your-internal-secret-min-32-chars"

# ════════════════════════════════════════════════════
# SUPERADMIN
# (ton Discord User ID)
# ════════════════════════════════════════════════════
SUPERADMIN_DISCORD_ID="your-discord-user-id"

# ════════════════════════════════════════════════════
# STOCKAGE FICHIERS
# ════════════════════════════════════════════════════
UPLOADS_DIR="/var/www/discordpanel/uploads"

# ════════════════════════════════════════════════════
# NODE ENV
# ════════════════════════════════════════════════════
NODE_ENV="production"
